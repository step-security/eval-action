{
  "name": "eval-action",
  "description": "StepSecurity maintained GitHub Action for running Braintrust evals in CI",
  "version": "1.0.16",
  "author": "step-security",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/step-security/eval-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/eval-action.git"
  },
  "bugs": {
    "url": "https://github.com/step-security/eval-action/issues"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "vp run package",
    "format:write": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "watch": "vp run package:watch",
    "package": "vp pack",
    "package:watch": "vp pack --watch",
    "test": "vp test --passWithNoTests",
    "check": "vp check",
    "all": "vp check && vp run test && vp run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "axios": "^1.7.9",
    "braintrust": "^3.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.4.5",
    "vite-plus": "^0.2.4"
  }
}
